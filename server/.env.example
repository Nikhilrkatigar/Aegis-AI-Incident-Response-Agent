# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/aegis
CLIENT_ORIGIN=http://localhost:5173

# Agent models. Aegis walks this chain in LLM_ORDER; when a provider hits a rate or
# credit limit (or is down) the next one takes over, and the limited one is skipped for 5 minutes.
# Providers without a key are skipped. With no key at all Aegis runs on its rule engine.
LLM_ORDER=anthropic,openrouter,gemini,groq
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
SUMMARY_MODEL=claude-haiku-4-5
# OpenRouter: a free model by default; set anthropic/claude-sonnet-5 once the account has credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Gemini: each model has its own free daily quota, so several are listed
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_SUMMARY_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
AGENT_MAX_STEPS=15
TOOL_TIMEOUT_MS=5000

# Verification window after an action, in seconds
VERIFY_WINDOW_SEC=120

# Signs the single-use action tokens. Long random string in production.
ACTION_SIGNING_SECRET=
