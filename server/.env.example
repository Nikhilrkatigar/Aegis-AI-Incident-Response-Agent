# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/aegis
CLIENT_ORIGIN=http://localhost:5173

# Agent model. Aegis picks the first provider with a key, in this order:
#   1. ANTHROPIC_API_KEY    Claude direct
#   2. OPENROUTER_API_KEY   Claude through OpenRouter (needs credits on the account)
#   3. GEMINI_API_KEY       Gemini
# With no key at all Aegis runs on its rule engine.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
SUMMARY_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_SUMMARY_MODEL=gemini-flash-lite-latest
AGENT_MAX_STEPS=15
TOOL_TIMEOUT_MS=5000

# Verification window after an action, in seconds
VERIFY_WINDOW_SEC=120

# Signs the single-use action tokens. Long random string in production.
ACTION_SIGNING_SECRET=
