# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aegis
CLIENT_ORIGIN=http://localhost:5173

# Agent (without a key Aegis runs on its rule engine)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
SUMMARY_MODEL=claude-haiku-4-5
AGENT_MAX_STEPS=15
TOOL_TIMEOUT_MS=5000

# Verification window after an action, in seconds
VERIFY_WINDOW_SEC=120

# Signs the single-use action tokens. Long random string in production.
ACTION_SIGNING_SECRET=
